# Headers pour Netlify - Optimisation SEO et Performance

# Pas de Cache-Control ici : il s'appliquerait aussi aux pages HTML. Netlify
# les sert par défaut en revalidation et purge son CDN à chaque déploiement.
# En-têtes de sécurité et CSP : dans netlify.toml, pour n'en avoir qu'une source.

/sitemap.xml
  # Cache du sitemap
  Cache-Control: public, max-age=86400
  
/robots.txt
  # Cache du robots.txt
  Cache-Control: public, max-age=86400

# Fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  
# Images
/images/*
  Cache-Control: public, max-age=31536000, immutable
  
# CSS et JS
/_astro/*
  Cache-Control: public, max-age=31536000, immutable