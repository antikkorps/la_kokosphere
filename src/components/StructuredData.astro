---
import {
  SITE_DESCRIPTION,
  SITE_EMAIL,
  SITE_PHONE,
  SITE_TITLE,
  SITE_URL,
} from "../consts"
import { getSameAs, getSiteSettings } from "../lib/sanity"

interface Props {
  type?: "website" | "article" | "profile"
  title?: string
  description?: string
  url?: string
  image?: string
  article?: {
    publishedTime?: string
    modifiedTime?: string
    author?: string
    tags?: string[]
  }
}

const {
  type = "website",
  title,
  description = SITE_DESCRIPTION,
  url,
  image,
  article,
} = Astro.props

const currentUrl = url || `${SITE_URL}${Astro.url.pathname}`

// Réseaux sociaux et identité de la praticienne, éditables dans Sanity
const settings = await getSiteSettings()
const sameAs = getSameAs(settings)
const practitionerName = settings?.practitionerName || "Cécile Pascual"
const practitionerJobTitle = settings?.practitionerJobTitle || "Hypnothérapeute certifiée"
const practitionerDescription =
  settings?.practitionerDescription ||
  "Hypnothérapeute certifiée spécialisée dans la méthode ericksonienne"

// Identifiants stables : permettent de relier les entités entre elles
const BUSINESS_ID = `${SITE_URL}/#business`
const PERSON_ID = `${SITE_URL}/#person`

// Images du panneau de connaissances : un vrai logo, pas la favicon
const LOGO_URL = `${SITE_URL}/images/logo/logo_kokosphere-512.png`
const BUSINESS_IMAGE_URL = `${SITE_URL}/images/logo/logo_kokosphere-og.png`

const postalAddress = {
  "@type": "PostalAddress",
  streetAddress: "11 Rue du Docteur LEROY",
  addressLocality: "Le Mans",
  postalCode: "72000",
  addressRegion: "Sarthe",
  addressCountry: "FR",
}

// Schema de base pour le site web
const baseSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  inLanguage: "fr-FR",
  publisher: { "@id": BUSINESS_ID },
}

// Schema pour l'organisation (hypnothérapeute)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "MedicalBusiness", "HealthAndBeautyBusiness"],
  "@id": BUSINESS_ID,
  name: SITE_TITLE,
  alternateName: "Hypnothérapeute Le Mans",
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  logo: {
    "@type": "ImageObject",
    url: LOGO_URL,
    width: 512,
    height: 512,
  },
  image: BUSINESS_IMAGE_URL,
  telephone: SITE_PHONE,
  email: SITE_EMAIL,
  priceRange: "60€ - 90€",
  currenciesAccepted: "EUR",
  paymentAccepted: "Espèces, Chèque",
  address: postalAddress,
  geo: {
    "@type": "GeoCoordinates",
    latitude: 48.0061,
    longitude: 0.1996,
  },
  openingHours: ["Mo-Fr 09:00-19:00"],
  founder: { "@id": PERSON_ID },
  employee: { "@id": PERSON_ID },
  areaServed: [
    {
      "@type": "City",
      name: "Le Mans",
      sameAs: "https://fr.wikipedia.org/wiki/Le_Mans",
    },
    {
      "@type": "State",
      name: "Sarthe",
    },
  ],
  serviceArea: {
    "@type": "GeoCircle",
    geoMidpoint: {
      "@type": "GeoCoordinates",
      latitude: 48.0061,
      longitude: 0.1996,
    },
    geoRadius: "50000",
  },
  knowsAbout: [
    "Hypnose ericksonienne",
    "Gestion du stress",
    "Traitement de l'anxiété",
    "Phobies",
    "Addictions",
    "Troubles du sommeil",
    "Confiance en soi",
    "Développement personnel",
  ],
  medicalSpecialty: "Hypnotherapy",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services d'hypnothérapie au Mans",
    itemListElement: [
      {
        "@type": "Offer",
        price: "60",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        itemOffered: {
          "@type": "Service",
          name: "Consultation initiale d'hypnothérapie",
          description:
            "Séance initiale de 1h30 pour évaluer votre situation et définir vos objectifs au Mans",
          serviceType: "Hypnotherapy",
          areaServed: "Le Mans, Sarthe",
        },
      },
      {
        "@type": "Offer",
        price: "80",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        itemOffered: {
          "@type": "Service",
          name: "Séance d'hypnothérapie individuelle",
          description:
            "Séance d'hypnose personnalisée d'1h pour traiter le stress, l'anxiété, les phobies et addictions au Mans",
          serviceType: "Hypnotherapy",
          areaServed: "Le Mans, Sarthe",
        },
      },
      {
        "@type": "Offer",
        price: "350",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        itemOffered: {
          "@type": "Service",
          name: "Pack 5 séances d'hypnothérapie",
          description:
            "Pack de 5 séances d'hypnose pour un accompagnement complet au Mans",
          serviceType: "Hypnotherapy",
          areaServed: "Le Mans, Sarthe",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Hypnose en entreprise",
          description:
            "Ateliers et formations en hypnose pour améliorer le bien-être au travail au Mans",
          serviceType: "Corporate Wellness",
          areaServed: "Le Mans, Sarthe",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Hypnose à domicile",
          description:
            "Séances d'hypnothérapie dans le confort de votre domicile au Mans et en Sarthe",
          serviceType: "Home Healthcare",
          areaServed: "Le Mans, Sarthe",
        },
      },
    ],
  },
  // Profils externes renseignés dans Sanity (« Paramètres du site »)
  ...(sameAs.length > 0 ? { sameAs } : {}),
}

// Diplômes et certifications déclarés dans Sanity
const hasCredential = (settings?.credentials ?? [])
  .filter((credential) => credential?.name)
  .map((credential) => ({
    "@type": "EducationalOccupationalCredential",
    name: credential.name,
    ...(credential.issuer
      ? {
          recognizedBy: {
            "@type": "Organization",
            name: credential.issuer,
            ...(credential.issuerUrl ? { url: credential.issuerUrl } : {}),
          },
        }
      : {}),
    ...(credential.year ? { dateCreated: credential.year } : {}),
  }))

// Schema pour la personne (thérapeute)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": PERSON_ID,
  name: practitionerName,
  jobTitle: practitionerJobTitle,
  description: practitionerDescription,
  url: `${SITE_URL}/about/`,
  email: SITE_EMAIL,
  telephone: SITE_PHONE,
  image: BUSINESS_IMAGE_URL,
  address: postalAddress,
  worksFor: { "@id": BUSINESS_ID },
  hasOccupation: {
    "@type": "Occupation",
    name: "Hypnothérapeute",
    occupationalCategory: "29-1125.00",
    skills: [
      "Hypnose ericksonienne",
      "Gestion du stress",
      "Traitement des phobies",
      "Accompagnement des addictions",
    ],
  },
  ...(hasCredential.length > 0 ? { hasCredential } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
}

const schemas: any[] = [baseSchema, organizationSchema, personSchema]

// Article de blog : fraîcheur et paternité du contenu (E-E-A-T)
if (type === "article" && title) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title.length > 110 ? `${title.slice(0, 109)}…` : title,
    description,
    url: currentUrl,
    ...(article?.publishedTime ? { datePublished: article.publishedTime } : {}),
    dateModified: article?.modifiedTime || article?.publishedTime,
    author: {
      "@type": "Person",
      name: article?.author || practitionerName,
      url: `${SITE_URL}/about/`,
    },
    publisher: { "@id": BUSINESS_ID },
    ...(image ? { image } : {}),
    ...(article?.tags?.length ? { keywords: article.tags.join(", ") } : {}),
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": currentUrl,
    },
    inLanguage: "fr-FR",
  })
}

// Breadcrumb schema pour toutes les pages sauf la homepage
if (Astro.url.pathname !== "/") {
  const pathSegments = Astro.url.pathname.split("/").filter((segment: string) => segment)
  const breadcrumbList = pathSegments.map((segment: string, index: number) => ({
    "@type": "ListItem",
    position: index + 2, // +2 car on commence après "Accueil"
    name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, " "),
    // URLs canoniques : avec slash final, comme les liens du site
    item: `${SITE_URL}/${pathSegments.slice(0, index + 1).join("/")}/`,
  }))

  schemas.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Accueil",
        item: `${SITE_URL}/`,
      },
      ...breadcrumbList,
    ],
  })
}
---

{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
