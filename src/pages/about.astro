---
import LaKokosphere from '@/components/LaKokosphere.astro';
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getKokosphere } from '../lib/sanity';

// Récupérer les données de la Kokosphere depuis Sanity
const kokosphereData = await getKokosphere();
---

<BaseLayout title={`À propos - Hypnothérapeute Le Mans | ${SITE_TITLE}`} description="Découvrez mon parcours, ma formation et ma philosophie en tant qu'hypnothérapeute professionnelle au Mans. Cécile Pascual, praticienne certifiée en hypnose ericksonienne. Approche bienveillante et personnalisée." keywords="hypnothérapeute Le Mans, Cécile Pascual, praticien hypnose Le Mans, formation hypnose ericksonienne, thérapeute certifié Le Mans">
		
		<!-- Hero Section -->
		<section class="bg-gradient-to-br from-primary-50 to-secondary-50 section-padding">
			<div class="container-max">
				<div class="text-center">
					<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
						À propos - Hypnothérapeute Le Mans
					</h1>
					<p class="text-xl text-gray-600 max-w-3xl mx-auto">
						Hypnothérapeute passionnée au Mans, je mets mon expertise au service de votre bien-être et de votre épanouissement personnel. Séances à domicile dans toute la Sarthe.
					</p>
				</div>
			</div>
		</section>

		<!-- Présentation Section -->
		<section class="section-padding bg-white">
			<div class="container-max">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<h2 class="text-3xl font-bold text-gray-900 mb-6">
							Qui suis-je ?
						</h2>
						<div class="prose prose-lg text-gray-600">
							<p class="mb-6">
								Je suis <strong>Cécile Pascual del Riquelme</strong>, praticienne en hypnose ericksonienne et fondatrice de <strong>La Kokosphere</strong> au Mans.
							</p>
							<p class="mb-6">
								J'accompagne les particuliers et les professionnels au Mans et dans toute la Sarthe, directement à domicile, pour des séances d'hypnose sur-mesure, dans un cadre familier, sécurisant et apaisant.
							</p>
							<p class="mb-6">
								Stress, fatigue, charge mentale, besoin de changement ou de recentrage…
							</p>
							<p class="mb-6">
								Je vous aide à retrouver équilibre, clarté et mieux-être, grâce à une approche douce, respectueuse et centrée sur vos ressources.
							</p>
							<div class="mt-8 p-6 bg-primary-50 rounded-xl border border-primary-100">
								<p class="text-xl font-semibold text-primary-700 mb-2">
									🪷 Offrez-vous un moment rien qu'à vous, sans avoir à vous déplacer.
								</p>
								<p class="text-lg text-primary-600">
									Je viens à vous, pour vous accompagner là où tout commence : en vous-même.
								</p>
							</div>
						</div>
					</div>
					<div class="relative">
						<div class="bg-gradient-to-br from-primary-100 to-secondary-100 rounded-2xl p-8">
							<div class="aspect-square bg-white rounded-xl overflow-hidden shadow-lg transform rotate-3 hover:rotate-0 transition-transform duration-300">
								<img 
									src="/images/cecile/Cecile1.webp" 
									alt="Cécile - Hypnothérapeute" 
									class="w-full h-full object-cover"
									loading="lazy"
								/>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Formation et Qualifications -->
		<section class="section-padding bg-gray-50">
			<div class="container-max">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
						Ma formation et mes qualifications
					</h2>
					<p class="text-xl text-gray-600 max-w-3xl mx-auto">
						Une formation solide et continue pour vous garantir un accompagnement professionnel et efficace.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					<div class="bg-white rounded-xl p-8 shadow-sm">
						<div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
							<svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-4">Formation initiale</h3>
						<p class="text-gray-600">
							Formation complète en hypnothérapie dans un institut reconnu, incluant les techniques classiques et modernes d'hypnose thérapeutique.
						</p>
					</div>

					<div class="bg-white rounded-xl p-8 shadow-sm">
						<div class="w-16 h-16 bg-secondary-100 rounded-lg flex items-center justify-center mb-6">
							<svg class="w-8 h-8 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-4">Certifications</h3>
						<p class="text-gray-600">
							Certifications professionnelles en hypnose Ericksonienne, hypnose conversationnelle et techniques de PNL pour un accompagnement complet.
						</p>
					</div>

					<div class="bg-white rounded-xl p-8 shadow-sm">
						<div class="w-16 h-16 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
							<svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-4">Formation continue</h3>
						<p class="text-gray-600">
							Formation continue régulière pour rester à jour des dernières avancées en hypnothérapie et psychologie.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Ressources bibliographiques -->
		<section class="section-padding bg-white">
			<div class="container-max">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
						Mes ressources de référence
					</h2>
					<p class="text-xl text-gray-600 max-w-3xl mx-auto">
						Des ouvrages fondamentaux qui inspirent ma pratique et enrichissent mon approche thérapeutique.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
					<div class="order-2 md:order-1">
						<div class="space-y-6">
							<div>
								<h3 class="text-2xl font-semibold text-gray-900 mb-4">Une connaissance approfondie</h3>
								<p class="text-lg text-gray-600 mb-6">
									Ma pratique s'appuie sur des ouvrages de référence en hypnose, psychologie et développement personnel. Ces ressources me permettent d'intégrer les meilleures approches pour vous accompagner efficacement.
								</p>
								<p class="text-lg text-gray-600">
									Chaque livre apporte un éclairage précieux sur le fonctionnement de l'esprit humain et les techniques thérapeutiques éprouvées.
								</p>
							</div>
						</div>
					</div>
					<div class="order-1 md:order-2">
						<div class="relative">
							<div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
								<div class="bg-gradient-to-br from-primary-100 to-secondary-100 rounded-2xl p-6 transform -rotate-3 hover:rotate-0 transition-transform duration-300 shadow-lg">
									<div class="w-48 h-64 bg-white rounded-lg overflow-hidden">
										<img
											src="/images/illustrationsSite/book1.webp"
											alt="Livre de référence 1"
											class="w-full h-full object-cover"
											loading="lazy"
										/>
									</div>
								</div>
								<div class="bg-gradient-to-br from-secondary-100 to-primary-100 rounded-2xl p-6 transform rotate-3 hover:rotate-0 transition-transform duration-300 shadow-lg">
									<div class="w-48 h-64 bg-white rounded-lg overflow-hidden">
										<img
											src="/images/illustrationsSite/book2.webp"
											alt="Livre de référence 2"
											class="w-full h-full object-cover"
											loading="lazy"
										/>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Ma philosophie -->
		<section class="section-padding bg-white">
			<div class="container-max">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div class="order-2 lg:order-1">
						<div class="bg-gradient-to-br from-secondary-100 to-primary-100 rounded-2xl p-8">
							<div class="aspect-square bg-white rounded-xl flex items-center justify-center shadow-lg">
								<div class="aspect-square bg-white rounded-xl overflow-hidden shadow-lg transform rotate-3 hover:rotate-0 transition-transform duration-300">
									<img 
										src="/images/illustrationsSite/handsandbook.webp" 
										alt="Cécile - Hypnothérapeute" 
										class="w-full h-full object-cover"
										loading="lazy"
									/>
								</div>
							</div>
						</div>
					</div>
					<div class="order-1 lg:order-2">
						<h2 class="text-3xl font-bold text-gray-900 mb-6">
							Ma philosophie
						</h2>
						<div class="space-y-6">
							<div class="flex items-start">
								<div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center flex-shrink-0 mr-4 mt-1">
									<svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
								</div>
								<div>
									<h3 class="text-lg font-semibold text-gray-900 mb-2">Bienveillance</h3>
									<p class="text-gray-600">
										Chaque personne est accueillie avec bienveillance et sans jugement. Je crée un espace de confiance où vous pouvez vous exprimer librement.
									</p>
								</div>
							</div>
							<div class="flex items-start">
								<div class="w-8 h-8 bg-secondary-100 rounded-full flex items-center justify-center flex-shrink-0 mr-4 mt-1">
									<svg class="w-4 h-4 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
								</div>
								<div>
									<h3 class="text-lg font-semibold text-gray-900 mb-2">Personnalisation</h3>
									<p class="text-gray-600">
										Chaque accompagnement est unique et adapté à vos besoins spécifiques. Je m'adapte à votre rythme et à votre personnalité.
									</p>
								</div>
							</div>
							<div class="flex items-start">
								<div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center flex-shrink-0 mr-4 mt-1">
									<svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
								</div>
								<div>
									<h3 class="text-lg font-semibold text-gray-900 mb-2">Autonomie</h3>
									<p class="text-gray-600">
										Mon objectif est de vous rendre autonome en vous donnant les outils et les ressources pour gérer vos difficultés au quotidien.
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section-padding bg-gray-50">
			<LaKokosphere 
				title={kokosphereData?.title}
				subtitle={kokosphereData?.subtitle}
				intro={kokosphereData?.intro}
				hypnoseDescription={kokosphereData?.hypnoseDescription}
				workDescription={kokosphereData?.workDescription}
				workBenefits={kokosphereData?.workBenefits}
				autoHypnoseDescription={kokosphereData?.autoHypnoseDescription}
				whyChooseDescription={kokosphereData?.whyChooseDescription}
				approachDescription={kokosphereData?.approachDescription}
				conclusion={kokosphereData?.conclusion}
			/>
		</section>
		<!-- Déroulement d'une séance -->
		<section class="section-padding bg-gray-50">
			<div class="container-max">
				<div class="text-center mb-16">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
						Comment se déroule une séance ?
					</h2>
					<p class="text-xl text-gray-600 max-w-3xl mx-auto">
						Découvrez le processus d'accompagnement en hypnothérapie, de la première consultation au suivi.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
					<div class="text-center">
						<div class="w-20 h-20 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-6">
							<span class="text-white text-2xl font-bold">1</span>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-4">Premier contact</h3>
						<p class="text-gray-600">
							Échange téléphonique ou par email pour comprendre votre demande et fixer un premier rendez-vous.
						</p>
					</div>

					<div class="text-center">
						<div class="w-20 h-20 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-6">
							<span class="text-white text-2xl font-bold">2</span>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-4">Consultation initiale</h3>
						<p class="text-gray-600">
							Première séance d'évaluation pour comprendre votre problématique et définir ensemble vos objectifs.
						</p>
					</div>

					<div class="text-center">
						<div class="w-20 h-20 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-6">
							<span class="text-white text-2xl font-bold">3</span>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-4">Séances de travail</h3>
						<p class="text-gray-600">
							Séances d'hypnothérapie personnalisées pour travailler sur vos objectifs et faciliter le changement.
						</p>
					</div>

					<div class="text-center">
						<div class="w-20 h-20 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-6">
							<span class="text-white text-2xl font-bold">4</span>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-4">Suivi et consolidation</h3>
						<p class="text-gray-600">
							Suivi régulier pour consolider les progrès et s'assurer de la durabilité des changements.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="section-padding bg-primary-600">
			<div class="container-max text-center">
				<h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
					Prêt(e) à commencer votre transformation ?
				</h2>
				<p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
					Prenez rendez-vous pour une première consultation et découvrez comment l'hypnothérapie peut vous aider.
				</p>
				<a href="/rendez-vous/" class="bg-white text-primary-600 hover:bg-gray-100 font-medium py-4 px-8 rounded-lg transition-colors duration-200 inline-flex items-center justify-center text-lg">
					Prendre rendez-vous
				</a>
			</div>
		</section>

</BaseLayout>
