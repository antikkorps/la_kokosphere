{
  "name": "la-kokosphere",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:ci": "npm run build && node --test \"tests/**/*.test.js\"",
    "astro": "astro",
    "dev:all": "concurrently \"npm run dev\" \"npm run studio\"",
    "studio": "cd studio-sanity && npm run dev",
    "studio:build": "cd studio-sanity && npm run build",
    "studio:deploy": "cd studio-sanity && npm run deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.2",
    "@sanity/client": "^7.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "gsap": "^3.13.0",
    "jose": "^6.0.11",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.1.1",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.17"
  },
  "netlifyFunctions": {
    "dependencies": {
      "@octokit/rest": "^22.0.0"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "node-html-parser": "^9.0.3"
  }
}
