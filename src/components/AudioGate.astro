---
/**
 * Formulaire qui offre un audio contre un prénom et un email. La fonction
 * audio-download inscrit le contact dans Brevo et renvoie une URL R2 signée,
 * que le navigateur suit pour lancer le téléchargement.
 */
interface Props {
  audio: "flux-mental" | "regeneration"
  title: string
  text: string
  emailLabel?: string
  button?: string
  sectionClass?: string
}

const {
  audio,
  title,
  text,
  emailLabel = "Votre adresse email",
  button = "Télécharger l'audio",
  sectionClass = "bg-gray-50",
} = Astro.props
const id = `audio-${audio}`
---

<section class:list={["section-padding", sectionClass]} aria-labelledby={`${id}-title`}>
  <div class="container-max">
    <div class="max-w-3xl mx-auto bg-white rounded-2xl p-8 md:p-12 shadow-xs border border-gray-200">
      <h2 id={`${id}-title`} class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">{title}</h2>
      <p class="text-lg text-gray-600 mb-8 leading-relaxed text-center">{text}</p>

      <form data-audio-gate={audio} class="space-y-4" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="block text-sm font-medium text-gray-700 mb-1">Votre prénom</span>
            <input name="prenom" type="text" required maxlength="80" autocomplete="given-name"
              class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-primary-500 focus:ring-primary-500" />
          </label>
          <label class="block">
            <span class="block text-sm font-medium text-gray-700 mb-1">{emailLabel}</span>
            <input name="email" type="email" required autocomplete="email"
              class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-primary-500 focus:ring-primary-500" />
          </label>
        </div>

        <!-- Champ piège : invisible pour un humain, rempli par les robots. -->
        <div class="hidden" aria-hidden="true">
          <label>Site web <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>

        <label class="flex items-start gap-3 text-sm text-gray-600">
          <input name="newsletter" type="checkbox" class="mt-1 rounded border-gray-300 text-primary-600" />
          <span>Je souhaite aussi recevoir la newsletter de La Kokosphère (désinscription en un clic).</span>
        </label>

        <button type="submit" class="btn-primary w-full text-lg py-4">{button}</button>
        <p data-message class="text-center text-sm min-h-[1.25rem]" role="status" aria-live="polite"></p>

        <p class="text-xs text-gray-500 text-center">
          Vos données servent uniquement à traiter cette demande et ne sont jamais cédées.
          <a href="/politique-confidentialite/" class="underline hover:text-gray-700">En savoir plus</a>
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  function setMessage(el: HTMLElement, text: string, isError = false) {
    el.textContent = text
    el.classList.toggle("text-red-600", isError)
    el.classList.toggle("text-gray-700", !isError)
  }

  async function requestDownload(form: HTMLFormElement): Promise<string | undefined> {
    const data = new FormData(form)
    const response = await fetch("/.netlify/functions/audio-download", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        audio: form.dataset.audioGate,
        prenom: data.get("prenom"),
        email: data.get("email"),
        website: data.get("website"),
        newsletter: data.get("newsletter") === "on",
      }),
    })
    if (!response.ok) throw new Error(String(response.status))
    return (await response.json()).url
  }

  async function onSubmit(event: SubmitEvent) {
    event.preventDefault()
    const form = event.currentTarget as HTMLFormElement
    const message = form.querySelector<HTMLElement>("[data-message]")!
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!

    if (!form.checkValidity()) {
      form.reportValidity()
      return
    }

    button.disabled = true
    setMessage(message, "Préparation de votre audio…")
    try {
      const url = await requestDownload(form)
      // Sans lien, le champ piège a été rempli, parfois par l'autoremplissage
      // d'un navigateur : l'humain doit pouvoir réessayer, pas rester bloqué.
      if (!url) throw new Error("aucun lien")

      // Un lien de secours, au cas où le navigateur bloquerait la redirection.
      const link = Object.assign(document.createElement("a"), { href: url, className: "underline", textContent: "Cliquez ici" })
      setMessage(message, "Votre téléchargement démarre. Rien ne se passe ? ")
      message.append(link, ".")
      window.location.assign(url)
      form.reset()
    } catch {
      setMessage(message, "Une erreur est survenue. Veuillez réessayer.", true)
    } finally {
      button.disabled = false
    }
  }

  document.querySelectorAll<HTMLFormElement>("form[data-audio-gate]").forEach((form) => {
    form.addEventListener("submit", onSubmit)
  })
</script>
